# SPDX-License-Identifier: AGPL-3.0-or-later
[Desktop Entry]
Name=Star
GenericName=Instant Messenger
Comment=Instant messaging and VoIP
Exec=app.star.Star %U
TryExec=app.star.Star
Icon=app.star.Star
Type=Application
Categories=Network;InstantMessaging;Chat;
Keywords=chat;im;messaging;messenger;voip;voice;video;call;
StartupWMClass=app.star.Star
SingleMainWindow=true
StartupNotify=true
MimeType=x-scheme-handler/star;
Terminal=false
X-GNOME-UsesNotifications=true
Actions=open-settings;new-dm;

[Desktop Action open-settings]
Name=Open Settings
Exec=app.star.Star --star-task=open-settings %U

[Desktop Action new-dm]
Name=New Direct Message
Exec=app.star.Star --star-task=new-dm %U
