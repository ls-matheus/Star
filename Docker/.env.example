# Perfis de teste SOMENTE NO MAC LOCAL. Nao use esta configuracao na internet.
# O monolito usa suas portas internas e expoe apenas a interface de loopback.
STAR_BUILD_VERSION=local
STAR_BUILD_JOBS=4
STAR_LOCAL_PORT=8080
STAR_VOICE_TCP_PORT=7881
STAR_VOICE_UDP_PORT=7882

# URLs deste perfil local HTTP; mudar porta exige mudar STAR_PUBLIC_ORIGIN.
STAR_DOMAIN=localhost
STAR_PUBLIC_SCHEME=http
STAR_PUBLIC_PORT=8080
STAR_PUBLIC_ORIGIN=http://localhost:8080

# O site :80 usa HTTP explicitamente; "acme" aqui faz o stard nao injetar
# a diretiva "tls internal" para o dominio nao publico localhost.
# Nao use esse perfil para exposicao publica.
STAR_EDGE_SITE_ADDRESS=:80
STAR_EDGE_TLS=acme
