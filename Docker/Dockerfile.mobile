# Build tool only. Does not package or deploy an iOS app.
# This upstream image stopped receiving updates in May 2026; pinning this
# known tag gives a reproducible baseline, not a long-term security guarantee.
FROM ghcr.io/cirruslabs/flutter:3.44.0@sha256:46691e311715845de03a3ba4753a475476936805b29431b1f00f1816981033f8

USER root
WORKDIR /work
COPY scripts/build-android.sh /usr/local/bin/star-build-android
RUN chmod 0755 /usr/local/bin/star-build-android
ENTRYPOINT ["/usr/local/bin/star-build-android"]
