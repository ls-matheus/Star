# Star SDK integration test credentials
# Copy this file to .env and fill in your values
# .env is gitignored and will not be committed

# Option 1: Direct token (use for live API with captcha protection)
STAR_TEST_TOKEN=

# Option 2: Email/password login (use for staging/local APIs without captcha)
STAR_TEST_EMAIL=
STAR_TEST_PASSWORD=

# API base URL (defaults to https://api.star.invalid/v1)
STAR_TEST_BASE_URL=https://api.star.invalid/v1
